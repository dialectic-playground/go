__pycache__/
*.py[cod]
.venv/

# Editors and operating systems
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Repository-specific
# Go build output (each project's BIN_DIR) and test/coverage artifacts
/*/bin/
*.test
coverage.out
